GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Every /api/* route checks this token. Left empty, the backend generates one on
# first start, saves it here and prints it once. To choose your own:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_TOKEN=
# Optional: extra browser origins allowed to call the API, comma separated
# (e.g. the address you open on your phone). localhost:5173 is always allowed.
JARVIS_ALLOWED_ORIGINS=
