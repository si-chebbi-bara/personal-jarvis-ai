GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required: every /api/* route checks this token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_TOKEN=
# Optional: extra browser origins allowed to call the API, comma separated
# (e.g. the address you open on your phone). localhost:5173 is always allowed.
JARVIS_ALLOWED_ORIGINS=
